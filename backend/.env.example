env
# === Database ===
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/vikas  # Async PostgreSQL connection string (asyncpg driver required)

# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co  # Supabase project URL
SUPABASE_KEY=your-supabase-service-role-key     # Supabase service-role key (backend only, never expose to frontend)

# === Authentication ===
JWT_SECRET=change-me-to-a-random-string-min-32-chars  # Secret for signing JWT tokens; generate with: openssl rand -hex 32
JWT_ALGORITHM=HS256                                    # JWT signing algorithm (HS256 is standard for symmetric keys)
ACCESS_TOKEN_EXPIRE_MINUTES=30                         # JWT token expiry in minutes

# === External Job Market APIs ===
ADZUNA_APP_ID=your-adzuna-app-id        # Adzuna API application ID (https://developer.adzuna.com/)
ADZUNA_APP_KEY=your-adzuna-app-key      # Adzuna API application key
JOOBLE_API_KEY=your-jooble-api-key      # Jooble API key (https://jooble.org/api/about)

# === LLM (Groq) ===
GROQ_API_KEY=your-groq-api-key  # Groq API key for Llama 3.3 calls (alerts, chat, parsing ONLY — never scoring)

# === CORS ===
CORS_ORIGINS=http://localhost:5173,http://localhost:3000  # Comma-separated allowed origins for CORS
