# === Backend API ===
VITE_API_BASE_URL=http://localhost:8000  # Backend API URL (must match backend's running port)

# === Supabase (public keys only — safe for frontend) ===
VITE_SUPABASE_URL=https://your-project.supabase.co  # Supabase project URL
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key        # Supabase anon key (public, row-level security enforced server-side)
